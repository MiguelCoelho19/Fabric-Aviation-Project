model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DirectLake - LH_Gold_Layer"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit"]

ref table 'Flight Status'
ref table Flights
ref table 'Flight Types'
ref table Airports
ref table Airlines
ref table Headlines
ref table Aircraft
ref table Dates
ref table 'Flight Time Status'

