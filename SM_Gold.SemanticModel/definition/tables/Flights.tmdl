table Flights
	lineageTag: 96125bd9-247c-4eaa-8f2a-e0a47b6a6a33
	sourceLineageTag: [dbo].[Flights]

	measure 'On Time and Early Flights' = ```
			
			CALCULATE(
			    COUNTROWS('Flights'),
			    'Flight Time Status'[Flight Time Status] = "Flight Early" || 'Flight Time Status'[Flight Time Status] = "Flight On Time" 
			)
			```
		formatString: 0
		lineageTag: cbec5b9f-8ca5-4bb1-a9d1-308bc0e64d5c

		changedProperty = Name

	measure 'Average Delay Minutes' =
			
			CALCULATE(
			    AVERAGEX(
			        'Flights',
			        DATEDIFF('Flights'[Schedule Departure Time], 'Flights'[Departure Time], MINUTE)
			    ),
			    'Flight Time Status'[Flight Time Status] = "Flight Delayed"
			)
		formatString: 0
		lineageTag: 38fd1202-3843-4d1f-9660-8d012d5c798c

		changedProperty = Name

